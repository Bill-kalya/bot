# Identity
MODEL_VERSION=momentum-v0.2.0
FEATURE_VERSION=features-v0.2.0
CONFIG_VERSION=config-v0.2.0

# Market
SYMBOL=BTC/USDT:USDT
EXCHANGE_ID=binanceusdm
DEMO=true

# Ledger
START_EQUITY=10

# Risk policy (research constraints — NOT production defaults)
MAX_LEVERAGE=20
MAX_LOSS_PER_TRADE_PCT=0.20
DAILY_LOSS_CAP_PCT=0.30
MIN_CONFIDENCE=0.30
MIN_EDGE=0.0005

# Cost reserves
SLIPPAGE_RESERVE=0.0005
FUNDING_RESERVE=0.0002
LATENCY_RESERVE=0.0002
STOP_SLIPPAGE_RESERVE=0.0010

# Loop
LOOP_SECONDS=30
CANDLE_LIMIT=60

# Reconciliation
RECONCILE_EVERY_LOOPS=20
FUNDING_LOOKBACK_HOURS=24

# Labeling
LABEL_EVERY_LOOPS=40

# News
# News feeds: name|url|reliability, semicolon-separated. Leave blank for defaults.
NEWS_FEEDS=
NEWS_POLL_SECONDS=300

# Strategy
STRATEGY=momentum
NEWS_LOOKBACK_MINUTES=120

# Shadow mode
SHADOW_MODE=true

# Tier 1 experiment flags
EXIT_MODE=stop_target          # stop_target | fixed_horizon
HOLD_MINUTES=60                # used when EXIT_MODE=fixed_horizon
REGIME_FILTER_ENABLED=false    # enables strategy/news_model_filtered.py

# Exchange keys (Phase 3+; leave blank for Phase 0 fake adapter)
BINANCE_API_KEY=
BINANCE_API_SECRET=